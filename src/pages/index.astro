---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../config.js";
import Hero from "../components/Hero.astro";
import Problems from "../components/Problems.astro";
import Benefits from "../components/Benefits.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import FreeTools from "../components/FreeTools.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";

const waLink = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(
  `Hola, vi ${SITE.name} y quiero saber cómo automatizar mi negocio.`
)}`;
---

<Layout
  title={`Recordatorios de cita por WhatsApp para negocios | ${SITE.name}`}
  description="Menos citas perdidas y más clientes que regresan: recordatorios de cita, reseñas en Google y seguimiento por WhatsApp para clínicas, spas, estéticas y talleres."
>
<Hero waLink={waLink} />

<Problems />

<Benefits />

<Services waLink={waLink} />
  
<Process />

<FreeTools />

<FAQ/>

<FinalCTA waLink={waLink} />

</Layout>