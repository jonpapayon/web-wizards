---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../config.js";

const waLink = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(
  `Hola, vi ${SITE.name} y quiero saber cómo automatizar mi negocio.`
)}`;
---

<Layout>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">✨ Automatización sin humo</span>
      <h1>
        Que tu negocio deje de perder tiempo
        <span class="gradient">en lo repetitivo</span>
      </h1>
      <p>
        Recordatorios de cita, reseñas y seguimiento por WhatsApp para
        clínicas, spas, estéticas, veterinarias y talleres. Simple, medible y
        sin tecnicismos.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={waLink} target="_blank" rel="noopener">
          Escríbeme por WhatsApp
        </a>
        <a class="btn btn-ghost" href="/calculadora">Calcula cuánto pierdes</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Los hechizos de la casa</h2>
      <p>Tres automatizaciones simples que resuelven lo que más se te escapa.</p>
      <div class="grid grid-3">
        <div class="card">
          <span class="card-tag">Recordatorios de cita</span>
          <h3>El hechizo anti-plantón</h3>
          <p>
            Mensajes por WhatsApp antes de cada cita, con opción de confirmar o
            reagendar.
          </p>
        </div>
        <div class="card">
          <span class="card-tag">Reseñas en Google</span>
          <h3>El hechizo de las cinco estrellas</h3>
          <p>
            Pide la reseña justo después de la visita y ayuda a que más gente
            te encuentre en Google Maps.
          </p>
        </div>
        <div class="card">
          <span class="card-tag">Seguimiento a clientes</span>
          <h3>El hechizo del regreso</h3>
          <p>
            Un mensaje a quien no ha vuelto en un tiempo, sin que tengas que
            acordarte tú.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Herramientas gratis</h2>
      <p>Úsalas sin compromiso para ver dónde se te va el dinero.</p>
      <div class="grid grid-3">
        <a class="card link" href="/calculadora">
          <span class="card-tag">Calculadora</span>
          <h3>Citas perdidas</h3>
          <p>Calcula cuánto dejas de ganar al mes cuando un cliente no llega.</p>
        </a>
        <div class="card soon">
          <span class="card-tag">Próximamente</span>
          <h3>Diagnóstico de procesos</h3>
          <p>Ocho preguntas para saber qué parte de tu negocio automatizar primero.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Cómo trabajo</h2>
      <div class="grid grid-3 steps">
        <div class="card">
          <h3>Entender tu proceso</h3>
          <p>
            Una charla corta para ver cómo manejas hoy tus citas y dónde se
            pierde tiempo o dinero.
          </p>
        </div>
        <div class="card">
          <h3>Instalar lo simple</h3>
          <p>
            Armo solo lo necesario, sin herramientas de más ni sistemas que
            nadie va a usar.
          </p>
        </div>
        <div class="card">
          <h3>Medir y ajustar</h3>
          <p>
            Revisamos los números al mes siguiente: citas confirmadas, reseñas
            y clientes que regresaron.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <h2>Sobre mí</h2>
      <p>
        Soy Joni. Tuve una tienda de bolsos en Morelia y viví de primera mano
        lo que cuesta cada cliente que no regresa y cada hora perdida en tareas
        repetitivas. Ahora uso la tecnología para quitarles esa carga a otros
        negocios, empezando por lo más simple y midiendo si funcionó.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>¿Lo platicamos?</h2>
      <p>Cuéntame cómo trabajas hoy y te digo si tiene sentido automatizarlo.</p>
      <div class="actions">
        <a class="btn btn-primary" href={waLink} target="_blank" rel="noopener">
          Escríbeme por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>