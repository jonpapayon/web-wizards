
---
import { SITE, NAV } from "../config.js";

const waLink = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(
  `Hola, vi ${SITE.name} y quiero saber cómo automatizar mi negocio.`
)}`;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name}, inicio`}>
      <span class="brand-symbol">W<span>.</span></span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {NAV.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a
      class="header-cta"
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>Hablemos</span>
      <span class="cta-arrow">↗</span>
    </a>

    <button
      class="mobile-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Navegación móvil">
      {NAV.map((item) => (
        <a href={item.href}>{item.label}<span>↗</span></a>
      ))}
    </nav>
    <a
      class="mobile-cta"
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
    >
      Hablemos de tu negocio ↗
    </a>
    <span class="mobile-caption">MENOS FRICCIÓN. MEJORES SISTEMAS.</span>
  </div>
</header>

<script>
  const header = document.querySelector(".site-header");
  const toggle = document.querySelector(".mobile-toggle");
  const menu = document.querySelector(".mobile-menu");

  if (header && toggle && menu) {
    const closeMenu = () => {
      header.classList.remove("menu-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú");
      menu.setAttribute("aria-hidden", "true");
    };

    toggle.addEventListener("click", () => {
      const isOpen = header.classList.toggle("menu-open");

      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
      menu.setAttribute("aria-hidden", String(!isOpen));
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 850) closeMenu();
    });

    window.addEventListener("scroll", () => {
      header.classList.toggle("scrolled", window.scrollY > 20);
    }, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    border-bottom: 1px solid rgba(255,255,255,.07);
    background: rgba(8,8,14,.78);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    transition: background .25s ease, border-color .25s ease;
  }

  .site-header.scrolled {
    background: rgba(8,8,14,.94);
    border-bottom-color: rgba(165,138,255,.15);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(1200px, calc(100% - 48px));
    height: 78px;
    margin: 0 auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #f4f2fa;
    text-decoration: none;
  }

  .brand-symbol {
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border: 1px solid rgba(165,138,255,.4);
    border-radius: 9px;
    background: linear-gradient(145deg, rgba(143,112,255,.2), rgba(143,112,255,.04));
    color: #f3efff;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -.08em;
  }

  .brand-symbol span {
    color: #a58aff;
  }

  .brand-name {
    font-size: 15px;
    font-weight: 750;
    letter-spacing: -.045em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(17px, 2.5vw, 34px);
  }

  .desktop-nav a {
    position: relative;
    padding: 9px 0;
    color: #a8a4b3;
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
    transition: color .2s ease;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 1px;
    background: #a58aff;
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .2s ease;
  }

  .desktop-nav a:hover {
    color: #fff;
  }

  .desktop-nav a:hover::after {
    transform: scaleX(1);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 39px;
    padding: 0 15px;
    border: 1px solid rgba(165,138,255,.3);
    border-radius: 6px;
    background: rgba(143,112,255,.1);
    color: #e5dcff;
    font-size: 10px;
    font-weight: 700;
    text-decoration: none;
    transition: background .2s ease, border-color .2s ease;
  }

  .header-cta:hover {
    border-color: rgba(165,138,255,.65);
    background: rgba(143,112,255,.2);
  }

  .cta-arrow {
    color: #b6a0ff;
    font-size: 15px;
  }

  .mobile-toggle,
  .mobile-menu {
    display: none;
  }

  @media (max-width: 850px) {
    .header-inner {
      width: calc(100% - 36px);
      height: 70px;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 42px;
      height: 42px;
      padding: 10px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 8px;
      background: rgba(255,255,255,.04);
      cursor: pointer;
    }

    .mobile-toggle span {
      display: block;
      width: 100%;
      height: 1px;
      background: #e9e4f5;
      transition: transform .2s ease;
    }

    .menu-open .mobile-toggle span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    .menu-open .mobile-toggle span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }

    .mobile-menu {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      gap: 25px;
      padding: 12px 24px 30px;
      border-bottom: 1px solid rgba(165,138,255,.2);
      background: rgba(8,8,14,.98);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
    }

    .menu-open .mobile-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
    }

    .mobile-menu nav a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 17px 0;
      border-bottom: 1px solid rgba(255,255,255,.07);
      color: #e9e5f2;
      font-size: 14px;
      text-decoration: none;
    }

    .mobile-menu nav a span {
      color: #a58aff;
      font-size: 16px;
    }

    .mobile-cta {
      display: flex;
      justify-content: center;
      padding: 15px;
      border: 1px solid rgba(165,138,255,.3);
      border-radius: 6px;
      background: rgba(143,112,255,.14);
      color: #e5dcff;
      font-size: 12px;
      font-weight: 700;
      text-decoration: none;
    }

    .mobile-caption {
      color: #777185;
      font-size: 8px;
      letter-spacing: .15em;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .desktop-nav a,
    .desktop-nav a::after,
    .header-cta,
    .mobile-toggle span,
    .mobile-menu {
      transition: none;
    }
  }
</style>
